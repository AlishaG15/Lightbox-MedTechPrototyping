(version 1)

(rule "Track Width"
	(condition "A.Type == 'track'")
	(constraint track_width (min 20mil))
)

(rule "Track Clearance"
	(condition "A.Type != 'pad' && B.Type != 'pad'")
	(constraint clearance (min 32mil))
)

(rule "Hole Size"
	(constraint hole_size (min 0.8mm) (max 3.2mm))
)

(rule "Hole Clearance"
	(condition "A.Type == 'pad' && A.Pad_Type == 'NPTH'")
	(constraint hole_clearance (min 20mil))
)

(rule "Footprints on F.Cu"
	(condition "A.Type == 'footprint' && A.Layer != 'F.Cu'")
	(constraint disallow footprint)
)

(rule "Tracks on B.Cu"
	(condition "A.Type == 'track' && A.Layer != 'B.Cu'")
	(constraint disallow track)
)

(rule "Pads on B.Cu"
	(condition "A.Type == 'pad' && A.Pad_Type != 'Through_Hole' && A.Layer != 'B.Cu'")
	(constraint disallow pad)
)

(rule "Zones on B.Cu"
	(condition "A.Type == 'zone' && A.Layer != 'B.Cu'")
	(constraint disallow zone)
)
